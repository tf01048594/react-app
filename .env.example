# Backend environment
DATABASE_URL=
JWT_SECRET=
PORT=3000

# AI coding agent provider: openai or gemini
LLM_PROVIDER=gemini

# Shared model override. Leave empty to use the provider-specific model below.
LLM_MODEL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Maximum number of self-correction cycles
AGENT_MAX_ITERATIONS=8
