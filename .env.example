# Backend environment
DATABASE_URL=
JWT_SECRET=
PORT=3000

# OpenAI API key used by scripts/agent.mjs
# Create this file locally as .env and put your real key here.
OPENAI_API_KEY=

# Model used by the local coding agent.
# Set this to an OpenAI API model available to your API account.
OPENAI_MODEL=

# Maximum number of self-correction cycles
AGENT_MAX_ITERATIONS=8
